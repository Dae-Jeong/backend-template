{
  "uid": "backend-spring-local",
  "title": "Backend Template · Spring Boot",
  "description": "Micrometer HTTP 처리·JVM·Hikari pool·업무 트랜잭션입니다. HTTP 처리는 클라이언트 수신 완료 보장이 아닙니다. DB 비활성·수집 중단·표본 없음은 No data로 구분합니다.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "수집 상태",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"spring-boot\"}",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "JVM heap 사용 / 상한",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance) (jvm_memory_used_bytes{job=\"spring-boot\",area=\"heap\"}) and on(instance) (up{job=\"spring-boot\"} == 1)",
          "legendFormat": "사용",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "sum by(instance) (jvm_memory_max_bytes{job=\"spring-boot\",area=\"heap\"}) and on(instance) (up{job=\"spring-boot\"} == 1)",
          "legendFormat": "상한",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No data",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "HTTP 처리량 · 최근 1분",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance,method,uri,status) (rate(http_server_requests_seconds_count{job=\"spring-boot\",uri!~\"/metrics|/health/.*\"}[1m])) and on(instance) (up{job=\"spring-boot\"} == 1)",
          "legendFormat": "{{method}} {{uri}} {{status}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "HTTP 처리 p95 · 최근 1분",
      "description": "Micrometer의 서버 처리 시간입니다. 전체 응답 전송이나 클라이언트 수신 완료를 뜻하지 않습니다.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(instance,le) (rate(http_server_requests_seconds_bucket{job=\"spring-boot\",uri!~\"/metrics|/health/.*\"}[1m]))) and on(instance) (up{job=\"spring-boot\"} == 1)",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Hikari 점유 / 상한 / 대기",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{job=\"spring-boot\"} and on(instance) (up{job=\"spring-boot\"} == 1)",
          "legendFormat": "{{pool}} 점유",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_max{job=\"spring-boot\"} and on(instance) (up{job=\"spring-boot\"} == 1)",
          "legendFormat": "{{pool}} 상한",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "hikaricp_connections_pending{job=\"spring-boot\"} and on(instance) (up{job=\"spring-boot\"} == 1)",
          "legendFormat": "{{pool}} 대기",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "title": "Hikari timeout · 프로세스 누적",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_timeout_total{job=\"spring-boot\"} and on(instance) (up{job=\"spring-boot\"} == 1)",
          "legendFormat": "{{pool}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 7,
      "title": "업무 트랜잭션 결과 · 프로세스 누적",
      "description": "Spring TransactionExecutionListener에서 실제 종료 결과를 기록합니다. 발생하지 않은 결과 label은 없을 수 있습니다.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "db_transactions_total{job=\"spring-boot\"} and on(instance) (up{job=\"spring-boot\"} == 1)",
          "legendFormat": "{{outcome}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 8,
      "title": "업무 트랜잭션 평균 · 프로세스 누적",
      "description": "Micrometer summary의 sum/count입니다. histogram p95와 다른 값입니다.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(db_transaction_duration_seconds_sum{job=\"spring-boot\"} / db_transaction_duration_seconds_count{job=\"spring-boot\"}) and on(instance) (up{job=\"spring-boot\"} == 1)",
          "legendFormat": "{{outcome}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    }
  ]
}
