{
  "uid": "backend-db-local",
  "title": "Backend Template · Local DB",
  "description": "Session 수와 연결 점유 수는 다릅니다. No data는 DB 미설정·수집 단절·표본 없음입니다. 획득 시간에는 새 연결과 검증 비용이 포함됩니다.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "수집 대상",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "local-prometheus"
        },
        "query": "label_values(up, job)",
        "refresh": 1,
        "current": {
          "text": "fastapi",
          "value": "fastapi"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "수집 상태",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"$job\"}",
          "legendFormat": "{{instance}} {{outcome}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "min": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "점유 연결 / 설정 상한",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "db_pool_connections_in_use{job=\"$job\"} and on(instance) (up{job=\"$job\"} == 1) and on(instance) db_pool_connection_limit{job=\"$job\"}",
          "legendFormat": "{{instance}} 점유",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "db_pool_connection_limit{job=\"$job\"} and on(instance) (up{job=\"$job\"} == 1) and on(instance) db_pool_connection_limit{job=\"$job\"}",
          "legendFormat": "{{instance}} 상한",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "활성 Session",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "db_sessions_active{job=\"$job\"} and on(instance) (up{job=\"$job\"} == 1) and on(instance) db_pool_connection_limit{job=\"$job\"}",
          "legendFormat": "{{instance}} {{outcome}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Pool timeout · 프로세스 누적",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "db_pool_timeouts_total{job=\"$job\"} and on(instance) (up{job=\"$job\"} == 1) and on(instance) db_pool_connection_limit{job=\"$job\"}",
          "legendFormat": "{{instance}} {{outcome}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "연결 점유 p95 · 최근 1분",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(instance, le) (rate(db_pool_connection_hold_seconds_bucket{job=\"$job\"}[1m]))) and on(instance) (up{job=\"$job\"} == 1) and on(instance) db_pool_connection_limit{job=\"$job\"}",
          "legendFormat": "{{instance}} {{outcome}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "title": "연결 획득 p95 · 최근 1분",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(instance, le) (rate(db_connection_acquire_seconds_bucket{job=\"$job\"}[1m]))) and on(instance) (up{job=\"$job\"} == 1) and on(instance) db_pool_connection_limit{job=\"$job\"}",
          "legendFormat": "{{instance}} {{outcome}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 7,
      "title": "업무 트랜잭션 결과 · 프로세스 누적",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "db_transactions_total{job=\"$job\"} and on(instance) (up{job=\"$job\"} == 1) and on(instance) db_pool_connection_limit{job=\"$job\"}",
          "legendFormat": "{{instance}} {{outcome}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 8,
      "title": "업무 트랜잭션 p95 · 최근 1분",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(instance, le) (rate(db_transaction_duration_seconds_bucket{job=\"$job\"}[1m]))) and on(instance) (up{job=\"$job\"} == 1) and on(instance) db_pool_connection_limit{job=\"$job\"}",
          "legendFormat": "{{instance}} {{outcome}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
